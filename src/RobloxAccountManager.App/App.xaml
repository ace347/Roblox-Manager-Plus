<Application x:Class="RobloxAccountManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RobloxAccountManager.App.Converters"
             xmlns:views="clr-namespace:RobloxAccountManager.App.Views"
             xmlns:viewModels="clr-namespace:RobloxAccountManager.App.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BooleanToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
            <conv:NavigationPageToBooleanConverter x:Key="NavigationPageToBooleanConverter"/>

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AccountsViewModel}">
                <views:AccountsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SessionsViewModel}">
                <views:SessionsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PageNoticeViewModel}">
                <Border Style="{StaticResource DashboardCard}"
                        MaxWidth="620"
                        Padding="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding Message}"
                                   Margin="0,10,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
