<UserControl x:Class="RobloxAccountManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewModels="clr-namespace:RobloxAccountManager.App.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,10,0">
            <ProgressBar x:Name="DashboardLoadingIndicator" Height="3" Margin="0,0,0,14" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <Border x:Name="DashboardErrorBanner" Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Retry" Margin="12,0,0,0"
                            Style="{StaticResource PrimaryAccentButton}" Command="{Binding RefreshCommand}"/>
                    <TextBlock Text="{Binding ErrorMessage}" VerticalAlignment="Center"
                               Foreground="#FCA5A5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
            <Border Background="#3B3112" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding HasUnmanagedPlayerProcess, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="A Roblox Player process is already running outside RAM Plus. It is not associated with a saved profile."
                           Foreground="#FCD34D" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#123B2A" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,12"
                    Visibility="{Binding LaunchMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding LaunchMessage}" Foreground="#A7F3D0" TextWrapping="Wrap"/>
            </Border>
            <!-- Header Section -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Welcome Back" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manage saved profiles and locally observed Roblox Player processes." 
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="+ Add Account" Style="{StaticResource PrimaryAccentButton}"
                    VerticalAlignment="Center"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{x:Static viewModels:NavigationPage.Accounts}"/>
            </Grid>

            <!-- Metrics Cards Grid -->
            <Grid x:Name="DashboardMetricsGrid" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Accounts Card -->
                <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL SAVED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalAccountsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Account profiles in the local vault" FontSize="12" Foreground="{StaticResource AccentPurpleBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Active Sessions Card -->
                <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="PLAYER PROCESSES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ActiveSessionsCount, TargetNullValue=Unavailable}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Observed by Windows; sign-in unverified" FontSize="12" Foreground="{StaticResource AccentElectricBlueBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Vault Health Card -->
                <Border x:Name="StoredSecretsCard" Grid.Column="4" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="STORED SECRETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding StoredSecretsCount}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                        <TextBlock Text="Saved through the DPAPI vault" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Quick Launch & Recent Accounts Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Accounts List -->
                <Border Grid.Column="0" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="Recent Accounts" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Content="View All" HorizontalAlignment="Right" Background="Transparent"
                                    Foreground="{StaticResource AccentElectricBlueBrush}" BorderThickness="0"
                                    Padding="0" FontSize="13"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static viewModels:NavigationPage.Accounts}"/>
                        </Grid>

                        <TextBlock Text="No accounts yet. Add a profile to see it here."
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                        <ItemsControl ItemsSource="{Binding RecentAccounts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardHoverBgBrush}" CornerRadius="10" Margin="0,0,0,10" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Circle -->
                                            <Border Width="42" Height="42" CornerRadius="21" Background="#2B2D3C" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AvatarPlaceholder}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <Border Background="#251F38" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding AuthenticationStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Launch Action -->
                                                <Button Grid.Column="2" Content="Launch" Style="{StaticResource PrimaryAccentButton}"
                                                    Padding="12,6" FontSize="12" VerticalAlignment="Center"
                                                    Command="{Binding DataContext.LaunchAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Launch the official Player; sign-in cannot be verified by RAM Plus."/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Quick Launch Panel -->
                <Border Grid.Column="2" Style="{StaticResource DashboardCard}">
                    <StackPanel>
                        <TextBlock Text="Quick Launch" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Launch the selected saved profile through the official Player." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" TextWrapping="Wrap"/>

                        <Border Background="{StaticResource SidebarBgBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SELECTED TARGET" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedAccount.DisplayName, FallbackValue='None'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedAccount.Username, FallbackValue='@none'}" FontSize="12" Foreground="{StaticResource AccentElectricBlueBrush}"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Launch Roblox Player" Style="{StaticResource PrimaryAccentButton}"
                            Height="40" Margin="0,0,0,10" Command="{Binding QuickLaunchCommand}"/>
                        <TextBlock Text="Sign in manually in the official client. RAM Plus cannot verify the signed-in account. Only one Player process is managed at a time."
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
