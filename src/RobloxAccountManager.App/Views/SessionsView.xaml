<UserControl x:Class="RobloxAccountManager.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Roblox Player Sessions" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Managed process state is tracked locally. Account sign-in is not verified by RAM Plus."
                           Margin="0,4,0,0" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Content="Refresh" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource PrimaryAccentButton}" Command="{Binding RefreshCommand}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Border Background="#3B3112" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding HasUnmanagedPlayerProcess, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="A Roblox Player process is already running outside RAM Plus. It is not associated with a saved profile; close it in the official client before launching a managed session."
                           Foreground="#FCD34D" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#123B2A" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource SidebarBgBrush}" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                              DisplayMemberPath="Username" Margin="0,0,12,0" MinWidth="220"
                              Background="#1F2230" Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              AutomationProperties.Name="Account profile to launch"/>
                    <Button Grid.Column="1" Content="Launch in Roblox Player"
                            Style="{StaticResource PrimaryAccentButton}"
                            Command="{Binding LaunchSelectedCommand}"/>
                </Grid>
            </Border>
            <TextBlock Text="Multiple accounts can be launched simultaneously. Each account gets its own authenticated Roblox Player session."
                       Margin="2,8,2,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ProgressBar Height="4" VerticalAlignment="Top" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <Border Style="{StaticResource DashboardCard}" Width="420" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="No managed launch history" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Launch a saved profile to begin tracking a Roblox Player process. Authentication remains unverified."
                               Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding Sessions}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding AccountUsername}" FontSize="17" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding AccountDisplayName}" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Status}" Margin="0,8,0,0"
                                               Foreground="{StaticResource AccentElectricBlueBrush}"/>
                                    <TextBlock Text="{Binding AuthenticationStatus}" Margin="0,2,0,0"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ProcessId, StringFormat=PID: {0}, TargetNullValue=PID: unavailable}"
                                               Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding LaunchedAtUtc, StringFormat=Launched: {0:g}}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding ExecutablePath}" Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding LastError}" Margin="0,4,0,0"
                                               Foreground="#FCA5A5" TextWrapping="Wrap"
                                               Visibility="{Binding LastError, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Close Session"
                                        VerticalAlignment="Top" Margin="12,0,0,0"
                                        Background="#3D1A24" Foreground="#F87171"
                                        Padding="12,7" BorderThickness="0"
                                        Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>