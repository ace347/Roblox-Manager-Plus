<UserControl x:Class="RobloxAccountManager.App.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RobloxAccountManager.Core.Models;assembly=RobloxAccountManager.Core"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600" d:DesignWidth="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="Roblox Player Sessions" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Live process monitor &amp; multi-instance session management."
                           Margin="0,4,0,0" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="🧹 Clear Inactive" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearInactiveCommand}"
                        ToolTip="Remove exited and inactive sessions from history"/>
                <Button Content="🔄 Refresh"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Alerts & Launch Control -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <Border Background="#3B3112" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding HasUnmanagedPlayerProcess, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="An unmanaged Roblox Player process is active outside RAM Plus."
                           Foreground="#FCD34D" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#123B2A" BorderBrush="{StaticResource AccentGreenBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding StatusMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" TextWrapping="Wrap"/>
            </Border>

            <!-- Launch Panel -->
            <Border Background="#161823" BorderBrush="#282C3D" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LAUNCH PROFILE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                  Margin="0,0,14,0" MinWidth="280" Height="38"
                                  Background="#1F2230" Foreground="{StaticResource TextPrimaryBrush}"
                                  BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                  AutomationProperties.Name="Account profile to launch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="#2E334D" Margin="0,0,8,0">
                                            <TextBlock Text="👤" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Username}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DisplayName, StringFormat=' ({0})'}" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="1" Content="▶ Launch in Roblox Player"
                            Style="{StaticResource PrimaryAccentButton}"
                            Height="40" Padding="20,0"
                            VerticalAlignment="Bottom"
                            Command="{Binding LaunchSelectedCommand}"/>
                </Grid>
            </Border>
            <TextBlock Text="● Multi-Instance Active — Multiple profiles can run concurrently. Each launches into an independent authenticated Roblox client."
                       Margin="4,8,4,0" FontSize="12" Foreground="#34D399"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Sessions List -->
        <Grid Grid.Row="2">
            <ProgressBar Height="4" VerticalAlignment="Top" IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

            <!-- Empty State -->
            <Border Style="{StaticResource DashboardCard}" Width="420" Padding="28"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🚀" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No active or tracked sessions" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select an account profile above and click Launch to start an authenticated Roblox Player instance."
                               Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Cards List -->
            <ListBox ItemsSource="{Binding Sessions}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Dynamic Card with Status Border -->
                        <Border x:Name="CardBorder" Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Avatar + Names + Status Badge + Action Button -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- User Avatar Circle -->
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#24283B"
                                            VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Username + DisplayName + Status Badge -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding AccountUsername}" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding AccountDisplayName, StringFormat=' ({0})'}" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,0" VerticalAlignment="Center"/>

                                            <!-- Dynamic Status Badge -->
                                            <Border x:Name="StatusBadge" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                <TextBlock x:Name="StatusBadgeText" Text="{Binding Status}" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions: Close Session if running, Dismiss if ended -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnCloseSession" Content="⏹ Close Session"
                                                Style="{StaticResource DangerButton}"
                                                Padding="12,6"
                                                Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button x:Name="BtnDismissSession" Content="✕ Remove"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,6" Margin="6,0,0,0"
                                                Command="{Binding DataContext.DismissSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Remove this record from session history"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Details Row: Chips for PID, Launch time, Auth state, Executable -->
                                <WrapPanel Grid.Row="1" Margin="52,10,0,0">
                                    <Border Background="#1F2333" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                        <TextBlock Text="{Binding ProcessId, StringFormat='PID: {0}', TargetNullValue='PID: --'}"
                                                   FontSize="11" Foreground="#94A3B8"/>
                                    </Border>
                                    <Border Background="#1F2333" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                        <TextBlock Text="{Binding LaunchedAtUtc, StringFormat='🕒 {0:g}'}"
                                                   FontSize="11" Foreground="#94A3B8"/>
                                    </Border>
                                    <Border Background="#1F2333" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                        <TextBlock Text="{Binding AuthenticationStatus}"
                                                   FontSize="11" Foreground="#94A3B8"/>
                                    </Border>
                                    <Border Background="#1F2333" CornerRadius="4" Padding="8,3" Margin="0,0,8,4">
                                        <TextBlock Text="{Binding ExecutablePath}"
                                                   FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                    </Border>
                                </WrapPanel>

                                <!-- Error Row (if any error) -->
                                <Border Grid.Row="2" Background="#2E1015" BorderBrush="#7F1D1D" BorderThickness="1"
                                        CornerRadius="6" Padding="10,6" Margin="52,8,0,0"
                                        Visibility="{Binding LastError, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding LastError}" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Dynamic Styling Triggers for Status -->
                        <DataTemplate.Triggers>
                            <!-- Running -->
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ClientSessionStatus.Running}">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#10B981"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="StatusBadge" Property="Background" Value="#064E3B"/>
                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#34D399"/>
                                <Setter TargetName="BtnCloseSession" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BtnDismissSession" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                            <!-- Launching -->
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ClientSessionStatus.Launching}">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#F59E0B"/>
                                <Setter TargetName="StatusBadge" Property="Background" Value="#451A03"/>
                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#FBBF24"/>
                                <Setter TargetName="BtnCloseSession" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BtnDismissSession" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>

                            <!-- Exited -->
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ClientSessionStatus.Exited}">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#2D3248"/>
                                <Setter TargetName="StatusBadge" Property="Background" Value="#1E2433"/>
                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#64748B"/>
                                <Setter TargetName="BtnCloseSession" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BtnDismissSession" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- StatusUnavailable -->
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ClientSessionStatus.StatusUnavailable}">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#7F1D1D"/>
                                <Setter TargetName="StatusBadge" Property="Background" Value="#3B1219"/>
                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="BtnCloseSession" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BtnDismissSession" Property="Visibility" Value="Visible"/>
                            </DataTrigger>

                            <!-- LaunchFailed -->
                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ClientSessionStatus.LaunchFailed}">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#7F1D1D"/>
                                <Setter TargetName="StatusBadge" Property="Background" Value="#3B1219"/>
                                <Setter TargetName="StatusBadgeText" Property="Foreground" Value="#F87171"/>
                                <Setter TargetName="BtnCloseSession" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="BtnDismissSession" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
