<UserControl x:Class="RobloxAccountManager.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">
    <Grid>
        <!-- Main Content -->
        <Grid Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Accounts Vault" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manage, edit, and organize all local Roblox profiles." 
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="+ Add Account" Style="{StaticResource PrimaryAccentButton}" 
                        Command="{Binding OpenAddDialogCommand}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <!-- Login with Roblox: opens embedded WebView2 and auto-captures the session cookie -->
                <Button Grid.Column="2" Content="🔑 Login with Roblox"
                        Background="#1E3A8A" Foreground="#93C5FD" FontWeight="SemiBold"
                        BorderThickness="0" Padding="14,8" Cursor="Hand" VerticalAlignment="Center"
                        Command="{Binding LoginWithRobloxCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Search & Filters Toolbar -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1F2230" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Padding="10,6" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <!-- Tag Filter -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTags}" SelectedItem="{Binding SelectedTag}"
                              Width="130" Margin="0,0,14,0" VerticalAlignment="Center"
                              Background="#1F2230" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2" Content="🔍 Search" Style="{StaticResource PrimaryAccentButton}"
                            Command="{Binding LoadAccountsCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border Grid.Row="2" Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,12" VerticalAlignment="Top"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontWeight="SemiBold"/>
            </Border>

            <!-- Empty State -->
            <Border Grid.Row="2" Style="{StaticResource DashboardCard}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32" Width="400"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Accounts Saved Yet" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click '+ Add Account' above to safely add your first profile." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                    <Button Content="+ Add First Account" Style="{StaticResource PrimaryAccentButton}" Command="{Binding OpenAddDialogCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Accounts Virtualized Cards List -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Accounts}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     VirtualizingStackPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Margin="0,0,0,10" Padding="16,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar -->
                                <Border Width="46" Height="46" CornerRadius="23" Background="#2B2D3C" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AvatarPlaceholder}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Metadata -->
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Border Background="#251F38" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBrush}"/>
                                        </Border>
                                        <Border Background="#123B2A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="★ DEFAULT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                                        </Border>
                                        <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="● RUNNING" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Username}" FontSize="13" Foreground="{StaticResource AccentElectricBlueBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding AuthenticationStatus}" FontSize="11" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="▶ Launch" Background="#1E3A8A" Foreground="#60A5FA" FontWeight="SemiBold"
                                            Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.LaunchAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVis}}"/>

                                    <Button Content="⏹ Close" Background="#3D1A24" Foreground="#F87171" FontWeight="SemiBold"
                                            Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding DataContext.CloseAccountSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

                                    <Button Content="★ Set Default" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.SetAsDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="✏️ Edit" Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,8,0"
                                            Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <Button Content="🗑️ Delete" Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Add / Edit Modal Overlay -->
        <Grid Background="#B2000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource DashboardCard}" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Account Details" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Roblox Username *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Display Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormDisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Tag / Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormTag, UpdateSourceTrigger=PropertyChanged}" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Personal Notes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Roblox Security Cookie (.ROBLOSECURITY) [Optional]" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormCookie, UpdateSourceTrigger=PropertyChanged}" Background="#1F2230" Foreground="#60A5FA" Padding="8" Margin="0,0,0,6"/>
                    <TextBlock Text="Encrypted locally using Windows DPAPI. Used to automatically generate launch tickets." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>

                    <CheckBox IsChecked="{Binding FormIsDefault}" Content="Mark as Default Account" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Background="#222533" Foreground="{StaticResource TextSecondaryBrush}" Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloseDialogCommand}"/>
                        <Button Content="Save Account" Style="{StaticResource PrimaryAccentButton}" Command="{Binding SaveAccountCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="3" Background="#99131A2A"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel Width="260" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar Height="4" IsIndeterminate="True"/>
                <TextBlock Text="Loading accounts..." Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
