<UserControl x:Class="RobloxAccountManager.App.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="850">
    <Grid>
        <!-- Main Content -->
        <Grid Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Accounts Vault" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manage, edit, and organize all local Roblox profiles." 
                               FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="+ Add Account" Style="{StaticResource PrimaryAccentButton}" 
                        Command="{Binding OpenAddDialogCommand}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Search & Filters Toolbar -->
            <Border Grid.Row="1" Background="{StaticResource SidebarBgBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Background="#1F2230" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                             Padding="10,6" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <!-- Tag Filter -->
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableTags}" SelectedItem="{Binding SelectedTag}"
                              Width="130" Margin="0,0,14,0" VerticalAlignment="Center"
                              Background="#1F2230" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2" Content="🔍 Search" Style="{StaticResource PrimaryAccentButton}"
                            Command="{Binding LoadAccountsCommand}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border Grid.Row="2" Background="#3B1219" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8"
                    Padding="12" Margin="0,0,0,12" VerticalAlignment="Top"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontWeight="SemiBold"/>
            </Border>

            <!-- Empty State -->
            <Border Grid.Row="2" Style="{StaticResource DashboardCard}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="32" Width="400"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock Text="No Accounts Saved Yet" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Click '+ Add Account' above to safely add your first profile." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,16"/>
                    <Button Content="+ Add First Account" Style="{StaticResource PrimaryAccentButton}" Command="{Binding OpenAddDialogCommand}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Accounts Virtualized Cards List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Margin="0,0,0,10" Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Width="46" Height="46" CornerRadius="23" Background="#2B2D3C" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AvatarPlaceholder}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Border Background="#251F38" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPurpleBrush}"/>
                                            </Border>
                                            <Border Background="#123B2A" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                    Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="★ DEFAULT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Username}" FontSize="13" Foreground="{StaticResource AccentElectricBlueBrush}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="★ Set Default" Background="#222533" Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="10,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.SetAsDefaultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="✏️ Edit" Background="#222533" Foreground="{StaticResource TextSecondaryBrush}"
                                                Padding="10,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.OpenEditDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>

                                        <Button Content="🗑️ Delete" Background="#3D1A24" Foreground="#F87171"
                                                Padding="10,6" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Add / Edit Modal Overlay -->
        <Grid Background="#B2000000" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource DashboardCard}" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Account Details" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="Roblox Username *" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Display Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormDisplayName, UpdateSourceTrigger=PropertyChanged}" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Tag / Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormTag, UpdateSourceTrigger=PropertyChanged}" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <TextBlock Text="Personal Notes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="#1F2230" Foreground="White" Padding="8" Margin="0,0,0,12"/>

                    <CheckBox IsChecked="{Binding FormIsDefault}" Content="Mark as Default Account" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Background="#222533" Foreground="{StaticResource TextSecondaryBrush}" Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"
                                Command="{Binding CloseDialogCommand}"/>
                        <Button Content="Save Account" Style="{StaticResource PrimaryAccentButton}" Command="{Binding SaveAccountCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
