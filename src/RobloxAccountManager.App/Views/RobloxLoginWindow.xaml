<Window x:Class="RobloxAccountManager.App.Views.RobloxLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Login to Roblox — RAM Plus"
        Width="520" Height="660"
        WindowStartupLocation="CenterOwner"
        Background="#0D0E12"
        Icon="../Assets/app_icon.ico"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#13141B" Padding="16,12">
            <StackPanel>
                <TextBlock Text="🔐  Sign in to Roblox"
                           FontSize="16" FontWeight="Bold"
                           Foreground="#F8FAFC"/>
                <TextBlock Text="Your credentials go directly to Roblox. RAM Plus only reads the session cookie after you sign in."
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- WebView2 embedded browser -->
        <wv2:WebView2 x:Name="WebView"
                      Grid.Row="1"
                      Source="https://www.roblox.com/login"/>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#13141B" Padding="16,8">
            <Grid>
                <TextBlock x:Name="StatusText"
                           Text="Waiting for login…"
                           FontSize="12" Foreground="#64748B"
                           VerticalAlignment="Center"/>
                <Button Content="Cancel"
                        HorizontalAlignment="Right"
                        Background="#2A2D3D" Foreground="#94A3B8"
                        BorderThickness="0" Padding="14,6" Cursor="Hand"
                        Click="Cancel_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
