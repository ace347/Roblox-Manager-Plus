<Window x:Class="RobloxAccountManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RobloxAccountManager.App.Views"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1100"
        MinHeight="600" MinWidth="850"
        Background="{StaticResource BgDarkBrush}" 
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel>
                <!-- Brand / Logo Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PurpleBlueGradient}" Margin="0,0,10,0">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RAM Plus" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Private Edition" FontSize="11" Foreground="{StaticResource AccentElectricBlueBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer / Status Info -->
                <Border DockPanel.Dock="Bottom" Background="#181A22" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Vault Active" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="v1.0.0 (Protected)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Tabs -->
                <StackPanel>
                    <RadioButton Content="📊  Dashboard" Style="{StaticResource NavRadioButton}" IsChecked="True" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Dashboard"/>
                    <RadioButton Content="👥  Accounts" Style="{StaticResource NavRadioButton}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Accounts"/>
                    <RadioButton Content="⚡  Activity" Style="{StaticResource NavRadioButton}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Activity"/>
                    <RadioButton Content="🔒  Security" Style="{StaticResource NavRadioButton}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Security"/>
                    <RadioButton Content="⚙️  Settings" Style="{StaticResource NavRadioButton}" 
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="28,24,28,24">
            <!-- Dashboard View -->
            <views:DashboardView DataContext="{Binding DashboardVm}">
                <views:DashboardView.Style>
                    <Style TargetType="views:DashboardView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Dashboard">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:DashboardView.Style>
            </views:DashboardView>

            <!-- Accounts View -->
            <views:AccountsView DataContext="{Binding AccountsVm}">
                <views:AccountsView.Style>
                    <Style TargetType="views:AccountsView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="Accounts">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:AccountsView.Style>
            </views:AccountsView>
        </Grid>
    </Grid>
</Window>
