<Window x:Class="RobloxAccountManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RobloxAccountManager.App.Views"
        xmlns:viewModels="clr-namespace:RobloxAccountManager.App.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="720" Width="1100"
        MinHeight="600" MinWidth="850"
        Background="{StaticResource BgDarkBrush}" 
        Icon="Assets/app_icon.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel>
                <!-- Brand / Logo Header -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#1A1C26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0" Padding="3">
                            <Image Source="Assets/app_logo.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Roblox-sessions" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="by TheEgos" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentElectricBlueBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Footer / Status Info -->
                <Border DockPanel.Dock="Bottom" Background="#181A22" CornerRadius="8" Padding="12" Margin="0,16,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="Vault Active" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="v1.0.0 (Protected)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Tabs -->
                <StackPanel>
                    <RadioButton x:Name="DashboardNavigation" Content="📊  Dashboard" Style="{StaticResource NavRadioButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource NavigationPageToBooleanConverter}, ConverterParameter={x:Static viewModels:NavigationPage.Dashboard}}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Dashboard}"/>
                    <RadioButton x:Name="AccountsNavigation" Content="👥  Accounts" Style="{StaticResource NavRadioButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource NavigationPageToBooleanConverter}, ConverterParameter={x:Static viewModels:NavigationPage.Accounts}}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Accounts}"/>
                    <RadioButton x:Name="SessionsNavigation" Content="▶  Sessions" Style="{StaticResource NavRadioButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource NavigationPageToBooleanConverter}, ConverterParameter={x:Static viewModels:NavigationPage.Sessions}}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Sessions}"/>
                    <RadioButton x:Name="ActivityNavigation" Content="⚡  Activity" Style="{StaticResource NavRadioButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource NavigationPageToBooleanConverter}, ConverterParameter={x:Static viewModels:NavigationPage.Activity}}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Activity}"/>
                    <RadioButton x:Name="SecurityNavigation" Content="🔒  Security" Style="{StaticResource NavRadioButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource NavigationPageToBooleanConverter}, ConverterParameter={x:Static viewModels:NavigationPage.Security}}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Security}"/>
                    <RadioButton x:Name="SettingsNavigation" Content="⚙️  Settings" Style="{StaticResource NavRadioButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource NavigationPageToBooleanConverter}, ConverterParameter={x:Static viewModels:NavigationPage.Settings}}"
                                 GroupName="MainNavigation"
                                 Command="{Binding NavigateCommand}" CommandParameter="{x:Static viewModels:NavigationPage.Settings}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area -->
        <ContentControl x:Name="MainContentHost"
                        Grid.Column="1"
                        Margin="28,24,28,24"
                        Content="{Binding CurrentPageViewModel}"/>
    </Grid>
</Window>
